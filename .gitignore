# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit secrets)
.env
.env.*
.env.local
.env.production
!env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# AI Assistant Files (NOT part of InternHub)
.claude
.z-ai-config
skills/
.zscripts/
examples/
mini-services/
# Root-anchored on purpose: an unanchored "download/" pattern matches ANY
# directory named "download" — including the API route
# src/app/api/reports/generated/[id]/download/ — which silently excluded it
# from git and broke report downloads on the deployment.
/download/
db/*.db
Caddyfile

# Logs & Debug
*.log
dev.log
dev.out.log
test
prompt
server.log

# Security - Never commit secrets
*.key
credentials*
secrets*

# Supabase local config (CLI-generated)
# Allow migrations/ and tests/ to be committed; ignore CLI-generated branches.
/supabase/.branches
/supabase/.temp
# NOTE: supabase/config.toml is intentionally committed — it contains the
# project-level CLI configuration needed for `supabase db lint`, `supabase db
# push`, and the Supabase Preview GitHub integration. It does NOT contain any
# secrets; all sensitive values are pulled from the linked project env.

# Upload directory (user files)
upload/

# Tool results (auto-generated)
tool-results/

# Work logs
worklog.md
