# ============================================================================
# InternHub.pk — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Supabase project values.
# Find these in your Supabase project: Settings -> API
#
# IMPORTANT: Never commit `.env.local` or any file containing real secrets.
# ============================================================================

# Supabase project URL (e.g. https://abcdefg.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key — safe to expose to the browser.
# This is the new name recommended by Supabase (formerly NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ----------------------------------------------------------------------------
# OPTIONAL — server-only variables (NEVER expose to the browser)
# ----------------------------------------------------------------------------
# These are NOT prefixed with NEXT_PUBLIC_ and are only accessible in
# Server Components, Route Handlers, and Server Actions.
#
# Use these ONLY for trusted admin operations such as bootstrapping the first
# super_admin or running migrations. NEVER import them into client code.
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
