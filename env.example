# ============================================================================
# InternHub.pk — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Supabase project values.
# Find these in your Supabase project: Settings -> API
#
# IMPORTANT: Never commit `.env.local` or any file containing real secrets.
# ============================================================================

# Supabase project URL (e.g. https://abcdefg.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key — safe to expose to the browser.
# This is the new name recommended by Supabase (formerly NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ----------------------------------------------------------------------------
# REQUIRED for Super Admin account creation — server-only variable
# ----------------------------------------------------------------------------
# This is REQUIRED for the Super Admin "Create User" flows to work correctly:
#   * /super-admin/company-hr  — "Add HR Account" button
#   * /super-admin/universities — admin account creation when adding a university
#
# These flows call POST /api/admin/create-user, which uses the service role
# key to call supabase.auth.admin.createUser(). This creates the new user
# WITHOUT establishing a session for them — so the currently-signed-in
# Super Admin stays signed in. (If we used supabase.auth.signUp() from the
# browser instead, the Super Admin would get logged OUT and the new user
# would get logged IN — a session hijack.)
#
# Find this in your Supabase project: Settings -> API -> "service_role" secret.
#
# NEVER prefix this with NEXT_PUBLIC_. NEVER import it into client code.
# It is only ever read inside /api/admin/create-user/route.ts.
#
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# REQUIRED for public certificate verification URLs (LinkedIn-shareable)
# ----------------------------------------------------------------------------
# The canonical public URL of your InternHub deployment. Used by
# src/lib/site-url.ts to generate STABLE, PUBLIC, CANONICAL certificate
# verification URLs that look like:
#
#   https://internhub.pk/verify/IH-VKSC-LIFT
#
# instead of rotting Vercel preview URLs like:
#
#   https://internhub-ommxwuglg-intern-hub1.vercel.app/verify/IH-VKSC-LIFT
#
# This URL is baked into the `certificates.verification_url` column at
# insert time, so it MUST be a stable production URL — NOT a Vercel
# deployment URL (those change on every preview deployment and would
# invalidate every previously-issued certificate's verification link).
#
# In local development:
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# In production:
#   NEXT_PUBLIC_APP_URL=https://internhub.pk
#
# This variable is preferred over NEXT_PUBLIC_SITE_URL (legacy alias).
# The code NEVER falls back to VERCEL_URL — that was the source of the
# rotting-preview-URL bug.
#
NEXT_PUBLIC_APP_URL=https://internhub.pk


# ============================================================================
# PHASE 1 ENHANCEMENTS — Push Notifications, PWA, Word Document Generation
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED for Push Notifications (VAPID keys)
# ----------------------------------------------------------------------------
# Generate these ONCE with:
#   npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY  — safe to expose to the browser (NOT a secret).
# VAPID_PRIVATE_KEY — server-only, NEVER expose.
# VAPID_SUBJECT    — mailto: or https: URL identifying your service.
#
# If these are not set, push notifications are gracefully disabled — the
# in-app notifications popover still works, but web push won't fire.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@internhub.pk

# ----------------------------------------------------------------------------
# Supabase Storage bucket for generated reports (private)
# ----------------------------------------------------------------------------
# The application expects a private storage bucket named "generated-reports"
# to exist for storing generated Word documents. Create it via the Supabase
# Dashboard (Storage → New bucket → name: "generated-reports" → Public: NO),
# or via the Supabase CLI. Generated docs are downloaded via 60-second
# signed URLs that require authentication to obtain.
